      "id": "conversation_sterilization_correction",
      "group": "multi_turn",
      "turns": [
        {
          "message": "I want to buy sterilization with opal",
          "expected_workflow": "catalog",
          "expected_needs_clarification": false,
          "expected_allow_no_products": true
        },
        {
          "message": "No i mean i want to see product with sterilization with opal color",
